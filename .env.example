# ProofPay — copy to .env.local. Simulation mode needs none of these.

# Public site URL (canonical links, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin token for GET /api/admin/access-requests (any long random string)
ADMIN_TOKEN=

# Salt for hashing IPs on the request-access form
IP_SALT=

# ── Live mode (Primus zkTLS). Server-side only. Never prefix with NEXT_PUBLIC_. ──
# Created in the Primus Developer Hub (https://dev.primuslabs.xyz): a project gives you appId + appSecret (shown once).
PRIMUS_APP_ID=
PRIMUS_APP_SECRET=
# Template id for the partner-API request (see README → Live mode)
PRIMUS_TEMPLATE_ID=
# Comma-separated attestor addresses the backend trusts for Live proofs (take them from Primus' docs / verifier registry)
PRIMUS_ATTESTORS=
# Token the demo partner API requires (partner-api/)
PARTNER_TOKEN=

# Chain: Base Sepolia (84532). RPC, escrow + mock-USDC addresses after `pnpm contracts:deploy`
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ESCROW_ADDRESS=
USDC_ADDRESS=
# Relayer/verifier key used only if the relayer fallback path is enabled. Testnet funds only.
RELAYER_PRIVATE_KEY=

# Database file (default: $TMPDIR/proofpay/proofpay.db — set this to persist demo data)
DATABASE_FILE=

# Deploy script (contracts/script/Deploy.s.sol). Run it on your own machine with a throwaway testnet key. Never commit it.
# PRIVATE_KEY=
# PRIMUS_VERIFIER=0x...   (re-check Primus' docs first)
# ARBITER=0x...
